{
    "name": "nimbro Dev Container",
    "build": {
        "dockerfile": "Dockerfile_jazzy",
        // "dockerfile": "Dockerfile_humble",
        "context": "../.."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-iot.vscode-ros",
                "ms-azuretools.vscode-docker"
            ]
        },
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        }
    },
    "postCreateCommand": "echo 'Development container ready.'",
    "remoteUser": "root",
    "runArgs": ["--network=host"],
    "workspaceMount": "source=${localWorkspaceFolder},target=/colcon_ws/src/nimbro_api,type=bind,consistency=consistent",
    "workspaceFolder": "/colcon_ws",
    "containerEnv": {
        "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
        "MISTRAL_API_KEY": "${localEnv:MISTRAL_API_KEY}",
        "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
        "VLLM_API_KEY": "${localEnv:VLLM_API_KEY}",
        "NIMBRO_VISION_API_KEY": "${localEnv:NIMBRO_VISION_API_KEY}"
    }
}